Checks: >
  clang-analyzer-*,
  modernize-*,-modernize-use-trailing-return-type,
  cppcoreguidelines-*,-cppcoreguidelines-special-member-functions,
  performance-*,
  readability-*,
  bugprone-*,
  cert-*,
  misc-*,-misc-include-cleaner

WarningsAsErrors: >
  clang-analyzer-*,
  modernize-*,
  cppcoreguidelines-*,
  performance-*,
  readability-*,
  bugprone-*,
  cert-*,
  misc-*

HeaderFilterRegex: 'src/lib/.*'
FormatStyle: file
ExtraArgs: []
